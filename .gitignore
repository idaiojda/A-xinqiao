# ============== IDE 配置（通用+项目特定）==============
# IntelliJ IDEA/Android Studio
.idea/
xinqiao/.idea/
*.iml
*.iws
*.ipr
.gradle/

# VS Code
.vscode/
*.code-workspace

# ============== 构建产物（统一匹配所有 build 变体）==============
# 根目录及所有子目录的 build 相关目录（含数字后缀、old 后缀）
**/build/
**/build[0-9]/
**/build_old/
**/build_old[0-9]/
# 排除后端静态资源目录（避免误忽略业务静态文件）
!xinqiao-backend/src/main/resources/static/

# ============== 预览/截图（只忽略冗余图，保留核心资源）==============
# 预览目录（纯预览文件，不含核心资源）
preview/
xinqiao/preview/
# 截图目录（测试截图，非代码资源）
screenshots/
xinqiao/screenshots/
# 特定命名的预览/测试图片（如 preview_xxx.png、verify_xxx.png）
preview_*.png
verify_*.png

# ============== 临时文件/调试文件 ==============
# 调试目录
src/debug/
# 特定临时文件
PATCH_TEST_MARKER.txt
scripts/
tasks_all.txt
# _dump 类调试文件
*_dump.xml
xinqiao/ui_*.xml
xinqiao/window_dump_*.xml

# ============== 文档/HTML（按需忽略）==============
# 中文文档（如果需要提交核心 README，删除此行或改为具体文件名）
xinqiao/*.md
# 预览型 HTML（不忽略后端业务静态资源）
index.html
xinqiao/index.html
# （可选）如果 community.html 是后端核心静态资源，注释此行
# xinqiao/community.html

# ============== 系统/其他冗余 ==============
# Windows 系统文件
Thumbs.db
Desktop.ini
# Mac 系统文件
.DS_Store
# 日志文件
*.log
# 敏感配置文件（按需添加）
.env
*.ini
*.properties.local
 
# ============== Node 前端依赖与重复项目 ==============
# 通用 Node 依赖目录
**/node_modules/
# 归档并忽略旧的管理端项目
admin-web/

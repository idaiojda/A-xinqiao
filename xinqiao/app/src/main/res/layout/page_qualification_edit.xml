<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="资质审核状态"
            android:textColor="@color/white"
            android:textSize="14sp"
            android:layout_marginBottom="4dp"/>
        <TextView
            android:id="@+id/tv_verify_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="待审核"
            android:textColor="@color/healing_color"
            android:textSize="16sp"
            android:layout_marginBottom="24dp"/>
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:endIconMode="dropdown_menu"
            app:boxStrokeColor="@color/settings_divider"
            app:hintTextColor="@color/settings_subtitle"
            app:boxBackgroundMode="outline">
            <com.google.android.material.textfield.MaterialAutoCompleteTextView
                android:id="@+id/et_education"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:hint="学历背景"
                android:inputType="none"
                android:textSize="16sp"
                android:padding="16dp"
                android:cursorVisible="false" />
        </com.google.android.material.textfield.TextInputLayout>
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:endIconMode="dropdown_menu"
            app:boxStrokeColor="@color/settings_divider"
            app:hintTextColor="@color/settings_subtitle"
            app:boxBackgroundMode="outline">
            <com.google.android.material.textfield.MaterialAutoCompleteTextView
                android:id="@+id/et_certifications"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:hint="专业认证"
                android:inputType="none"
                android:textSize="16sp"
                android:padding="16dp"
                android:cursorVisible="false" />
        </com.google.android.material.textfield.TextInputLayout>
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            app:endIconMode="dropdown_menu"
            app:boxStrokeColor="@color/settings_divider"
            app:hintTextColor="@color/settings_subtitle"
            app:boxBackgroundMode="outline">
            <com.google.android.material.textfield.MaterialAutoCompleteTextView
                android:id="@+id/et_years"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:hint="工作年限"
                android:inputType="none"
                android:textSize="16sp"
                android:padding="16dp"
                android:cursorVisible="false" />
        </com.google.android.material.textfield.TextInputLayout>
        <Button
            android:id="@+id/btn_upload_files"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="上传资质文件"
            android:background="@drawable/bg_save_button"
            android:layout_marginTop="8dp"/>
    </LinearLayout>
</ScrollView>
<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/white">

    <!-- 顶部搜索栏：输入框 + 取消按钮，样式参考 fragment_course_search -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp">

        <EditText
            android:id="@+id/et_search"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:background="@drawable/bg_searchbar_pill_selector"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:hint="搜索文章标题或分类"
            android:imeOptions="actionSearch"
            android:drawableLeft="@drawable/ic_search_blue"
            android:singleLine="true"
            android:gravity="center_vertical"
            android:includeFontPadding="false"
            android:textColor="#4E5969"
            android:textColorHint="#99B8FF"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tv_cancel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="取消"
            android:textColor="@color/colorPrimary"
            android:textSize="16sp" />
    </LinearLayout>

    <!-- 热搜推荐标题 -->
    <TextView
        android:id="@+id/tv_hot_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="热搜推荐"
        android:textStyle="bold"
        android:textSize="16sp"
        android:textColor="@color/black"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="4dp"
        android:paddingBottom="8dp" />

    <!-- 热搜推荐列表：复用 ArticleAdapter 卡片 -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_hot_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:padding="8dp" />

</LinearLayout>

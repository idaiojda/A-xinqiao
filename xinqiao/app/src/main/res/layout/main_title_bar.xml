<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/title_bar"
    android:layout_width="match_parent"
    android:layout_height="56dp"
    android:background="@color/white" >
    <TextView
        android:id="@+id/tv_back"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:layout_alignParentLeft="true"
        android:layout_centerVertical="true"
        android:background="@drawable/go_back_selector" />
    <!-- 居中标题（非课程页显示） -->
    <TextView
        android:id="@+id/tv_main_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        style="@style/TopBarTitleText"/>

    <!-- 课程页搜索框（默认隐藏，课程页显示） -->
    <EditText
        android:id="@+id/et_search_course"
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:layout_centerVertical="true"
        android:layout_toRightOf="@id/tv_back"
        android:layout_toLeftOf="@id/btn_search_top"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:hint="搜索课程"
        android:singleLine="true"
        android:imeOptions="actionSearch"
        android:drawableLeft="@drawable/ic_search_gray"
        android:drawablePadding="8dp"
        android:paddingLeft="12dp"
        android:paddingRight="12dp"
        android:background="@drawable/bg_search_input"
        android:textColor="@color/colorOnSecondary"
        android:textColorHint="@color/hint_text"
        android:textSize="14sp"
        android:visibility="gone"/>

    <!-- 右侧搜索按钮（圆角矩形，文本“搜索”，淡蓝底白字） -->
    <TextView
        android:id="@+id/btn_search_top"
        android:layout_width="wrap_content"
        android:layout_height="36dp"
        android:layout_centerVertical="true"
        android:layout_toRightOf="@id/tv_back"
        android:layout_toLeftOf="@id/ll_play_history_top"
        android:layout_marginEnd="8dp"
        android:paddingLeft="14dp"
        android:paddingRight="14dp"
        android:gravity="center"
        android:text="搜索"
        android:textSize="14sp"
        android:textColor="@color/topBarOnPrimary"
        android:background="@drawable/bg_search_button_primary"
        android:visibility="gone"/>

    <!-- 课程页右侧播放历史（默认隐藏，课程页显示） -->
    <LinearLayout
        android:id="@+id/ll_play_history_top"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_alignParentRight="true"
        android:paddingLeft="12dp"
        android:paddingRight="16dp"
        android:gravity="center_vertical"
        android:visibility="gone"
        android:background="?attr/selectableItemBackground">
        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_history"/>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="4dp"
            android:text="播放历史"
            android:textColor="@color/topBarPrimary"
            android:textSize="14sp"/>
    </LinearLayout>
    <TextView
        android:id="@+id/tv_save"
        android:layout_width="wrap_content"
        android:layout_height="30dp"
        android:layout_alignParentRight="true"
        android:layout_marginTop="10dp"
        android:layout_marginRight="20dp"
        android:layout_centerVertical="true"
        android:gravity="center"
        android:textSize="16sp"
        android:textColor="@android:color/white"
        android:text="保存"
        android:visibility="gone"
        />
</RelativeLayout>

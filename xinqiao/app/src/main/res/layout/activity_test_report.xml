<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:background="#F6F7FB">
        <TextView
            android:id="@+id/btn_back"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="返回"
            android:textSize="16sp"
            android:textColor="#30B4FF"/>
        <TextView
            android:id="@+id/tv_title_bar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="报告详情"
            android:textColor="#222222"
            android:textSize="17sp"
            android:gravity="center"/>
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:overScrollMode="never">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_summary_quote"
                android:padding="16dp">
                <TextView
                    android:id="@+id/tv_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="测评标题"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="#222222"/>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="8dp">
                    <TextView
                        android:id="@+id/tv_status"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="待支付"
                        android:textColor="#FF7A45"
                        android:textSize="13sp"
                        android:background="@drawable/bg_tag_free"
                        android:paddingLeft="8dp"
                        android:paddingRight="8dp"
                        android:paddingTop="4dp"
                        android:paddingBottom="4dp"/>
                    <TextView
                        android:id="@+id/tv_price"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="¥9.9"
                        android:textColor="#30B4FF"
                        android:textSize="13sp"
                        android:layout_marginStart="12dp"/>
                </LinearLayout>
                <TextView
                    android:id="@+id/tv_report_id"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="报告ID: RPT..."
                    android:textSize="13sp"
                    android:textColor="#666666"
                    android:layout_marginTop="8dp"/>
                <TextView
                    android:id="@+id/tv_date"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="日期: 2025-01-01"
                    android:textSize="13sp"
                    android:textColor="#666666"
                    android:layout_marginTop="2dp"/>
            </LinearLayout>

            <TextView
                android:id="@+id/tv_report_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="报告内容将在支付完成后展示或自动生成"
                android:textColor="#222222"
                android:textSize="16sp"
                android:lineSpacingExtra="6dp"
                android:layout_marginTop="16dp"/>

            <LinearLayout
                android:id="@+id/pay_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="16dp">
                <TextView
                    android:id="@+id/tv_pay_tip"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="支付后可查看完整报告（含风险等级与建议）"
                    android:textColor="#666666"
                    android:textSize="14sp"/>
                <TextView
                    android:id="@+id/tv_balance"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="余额：--"
                    android:textColor="#999999"
                    android:textSize="13sp"
                    android:layout_marginTop="8dp"/>
                <Button
                    android:id="@+id/btn_pay"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/btn_bg"
                    android:text="支付 ¥9.9"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"/>
                <Button
                    android:id="@+id/btn_recharge"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="去充值"
                    android:textColor="#FFFFFF"
                    android:background="@drawable/btn_bg"
                    android:textSize="16sp"/>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <View
        android:layout_width="match_parent"
        android:layout_height="8dp"
        android:background="#FFFFFF"/>

</LinearLayout>

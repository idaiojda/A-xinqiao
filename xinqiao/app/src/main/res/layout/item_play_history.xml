<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="16dp"
    android:background="?android:attr/selectableItemBackground">

    <!-- 视频缩略图区域（叠加右下角标签与未完成红点） -->
    <RelativeLayout
        android:layout_width="80dp"
        android:layout_height="60dp">

        <ImageView
            android:id="@+id/iv_thumbnail"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/ic_video_placeholder"
            android:scaleType="centerCrop"
            android:background="#F0F0F0"
            android:contentDescription="视频缩略图" />

        <!-- 右下角“视频”标签 -->
        <TextView
            android:id="@+id/tv_video_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:layout_alignParentEnd="true"
            android:layout_marginEnd="6dp"
            android:layout_marginBottom="6dp"
            android:paddingLeft="6dp"
            android:paddingRight="6dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:text="视频"
            android:textColor="#FFFFFF"
            android:textSize="10sp"
            android:background="@drawable/bg_video_badge"
            android:gravity="center" />

        <!-- 未完成红点（默认隐藏） -->
        <View
            android:id="@+id/dot_unfinished"
            android:layout_width="6dp"
            android:layout_height="6dp"
            android:layout_alignBottom="@id/tv_video_badge"
            android:layout_toStartOf="@id/tv_video_badge"
            android:layout_marginEnd="4dp"
            android:background="@drawable/dot_unfinished"
            android:visibility="gone" />

    </RelativeLayout>

    <!-- 视频信息 -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="12dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="视频标题"
            android:textColor="#333333"
            android:textSize="16sp"
            android:textStyle="bold"
            android:maxLines="2"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/tv_subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="视频副标题"
            android:textColor="#666666"
            android:textSize="14sp"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/tv_time"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="播放时间"
            android:textColor="#999999"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- 删除按钮 -->
    <ImageView
        android:id="@+id/iv_delete"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_gravity="center_vertical"
        android:src="@drawable/ic_delete"
        android:padding="4dp"
        android:contentDescription="删除" />

</LinearLayout> 

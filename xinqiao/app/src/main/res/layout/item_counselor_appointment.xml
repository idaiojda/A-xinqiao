<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="4dp"
    app:cardUseCompatPadding="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp">

        <!-- 用户头像 -->
        <de.hdodenhof.circleimageview.CircleImageView
            android:id="@+id/iv_user_avatar"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:src="@drawable/default_avatar"
            app:civ_border_width="2dp"
            app:civ_border_color="@color/healing_color"
            android:layout_marginEnd="12dp" />

        <!-- 主要内容区域 -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <!-- 用户姓名和状态 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="8dp">

                <TextView
                    android:id="@+id/tv_user_name"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="张小明"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/settings_title" />

                <TextView
                    android:id="@+id/tv_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="待处理"
                    android:textSize="12sp"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="4dp"
                    android:background="@drawable/bg_status_tag"
                    android:textColor="@color/white" />
            </LinearLayout>

            <!-- 预约时间 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="6dp">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_clock"
                    android:tint="@color/settings_subtitle"
                    android:layout_marginEnd="6dp" />

                <TextView
                    android:id="@+id/tv_appointment_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="2024-01-15 14:00-15:00"
                    android:textSize="14sp"
                    android:textColor="@color/settings_subtitle" />
            </LinearLayout>

            <!-- 咨询方式 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="12dp">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_video"
                    android:tint="@color/settings_subtitle"
                    android:layout_marginEnd="6dp" />

                <TextView
                    android:id="@+id/tv_consultation_type"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="视频咨询"
                    android:textSize="14sp"
                    android:textColor="@color/settings_subtitle" />
            </LinearLayout>

            <!-- 操作按钮组 -->
            <LinearLayout
                android:id="@+id/ll_action_buttons"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="end">

                <!-- 接受按钮 -->
                <Button
                    android:id="@+id/btn_accept"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:text="接受"
                    android:textSize="14sp"
                    android:textColor="@color/white"
                    android:background="@drawable/bg_button_primary"
                    android:layout_marginEnd="8dp"
                    android:paddingHorizontal="16dp" />

                <!-- 拒绝按钮 -->
                <Button
                    android:id="@+id/btn_reject"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:text="拒绝"
                    android:textSize="14sp"
                    android:textColor="@color/white"
                    android:background="@drawable/bg_button_outline"
                    android:paddingHorizontal="16dp" />

                <!-- 详情按钮（已确认状态显示） -->
                <Button
                    android:id="@+id/btn_details"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:text="详情"
                    android:textSize="14sp"
                    android:textColor="@color/white"
                    android:background="@drawable/bg_button_primary"
                    android:visibility="gone"
                    android:paddingHorizontal="16dp" />

                <!-- 评价按钮（已完成状态显示） -->
                <Button
                    android:id="@+id/btn_review"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:text="评价"
                    android:textSize="14sp"
                    android:textColor="@color/white"
                    android:background="@drawable/bg_button_primary"
                    android:visibility="gone"
                    android:paddingHorizontal="16dp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

</androidx.cardview.widget.CardView>
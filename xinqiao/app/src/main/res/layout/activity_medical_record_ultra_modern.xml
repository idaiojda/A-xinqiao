<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@android:color/white">

    <!-- Ultra-Modern Title Bar with Enhanced Visual Effects -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="88dp"
        android:background="@drawable/title_bar_gradient_modern"
        android:paddingLeft="20dp"
        android:paddingRight="20dp"
        android:paddingTop="32dp"
        android:paddingBottom="16dp"
        android:elevation="8dp">

        <!-- Background Pattern Overlay -->
        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/title_bar_pattern_overlay"
            android:alpha="0.1" />

        <!-- Back Button with Enhanced Ripple -->
            <ImageButton
                android:id="@+id/btn_back"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_gravity="start|center_vertical"
            android:background="@drawable/circle_ripple_white"
            android:src="@drawable/ic_arrow_back_white"
            android:padding="10dp"
                android:contentDescription="@string/back"
            android:elevation="2dp" />

        <!-- Enhanced Title Section with Animation Container -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:gravity="center_horizontal">

            <!-- Main Title with Shadow -->
            <TextView
                android:id="@+id/tv_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/medical_record_title"
                android:textColor="#FFFFFF"
                android:textSize="22sp"
                android:textStyle="bold"
                android:letterSpacing="0.03"
                android:fontFamily="sans-serif-medium"
                android:shadowColor="#40000000"
                android:shadowDx="1"
                android:shadowDy="2"
                android:shadowRadius="3"
                android:paddingBottom="2dp" />

            <!-- Subtitle with Enhanced Styling -->
            <TextView
                android:id="@+id/tv_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/medical_record_subtitle"
                android:textColor="#E6FFFFFF"
                android:textSize="13sp"
                android:letterSpacing="0.08"
                android:fontFamily="sans-serif-light"
                android:background="@drawable/subtitle_background"
                android:paddingLeft="12dp"
                android:paddingRight="12dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp" />

        </LinearLayout>

        <!-- Settings Button with Enhanced Design -->
            <ImageButton
                android:id="@+id/btn_settings"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_gravity="end|center_vertical"
            android:background="@drawable/circle_ripple_white"
            android:src="@drawable/ic_settings_white"
            android:padding="10dp"
                android:contentDescription="@string/settings"
            android:elevation="2dp"
            android:visibility="visible" />

        <!-- Floating Decorative Elements -->
        <View
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:layout_gravity="top|start"
            android:layout_marginTop="8dp"
            android:layout_marginStart="80dp"
            android:background="@drawable/floating_dot_white"
            android:alpha="0.6" />

        <View
            android:layout_width="6dp"
            android:layout_height="6dp"
            android:layout_gravity="top|end"
            android:layout_marginTop="12dp"
            android:layout_marginEnd="60dp"
            android:background="@drawable/floating_dot_white"
            android:alpha="0.4" />

    </FrameLayout>

    <!-- Enhanced TabLayout with Modern Styling -->
    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tab_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/tab_layout_gradient_enhanced"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        app:tabMode="fixed"
        app:tabGravity="fill"
        app:tabIndicatorHeight="3dp"
        app:tabIndicatorColor="@color/white"
        app:tabPaddingStart="6dp"
        app:tabPaddingEnd="6dp"
        app:tabMinWidth="0dp"
        app:tabTextAppearance="@style/TabTextAppearance.Modern"
        app:tabSelectedTextColor="@color/white"
        app:tabTextColor="#CCFFFFFF"
        app:tabRippleColor="@color/white_20_transparent" />

    <!-- ViewPager2 with Enhanced Background -->
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/view_pager"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@drawable/viewpager_gradient_background_enhanced" />

</LinearLayout>

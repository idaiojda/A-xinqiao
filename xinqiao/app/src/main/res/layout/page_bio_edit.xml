<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/white"
    android:fillViewport="true">
    
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- 基本信息标题 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp"
            android:paddingVertical="8dp">
            
            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_person"
                android:tint="@color/text_primary"
                android:layout_marginEnd="8dp"/>
            
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="基本信息"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:textStyle="bold"/>
        </LinearLayout>

        <!-- 头像和展示名 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/input_field_bg"
            android:padding="12dp"
            android:layout_marginBottom="12dp">
            
            <FrameLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="12dp">
                
                <de.hdodenhof.circleimageview.CircleImageView
                    android:id="@+id/iv_counselor_avatar_edit"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:src="@drawable/default_avatar"/>
                
                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_camera"
                    android:tint="@color/primary"
                    android:layout_gravity="bottom|end"
                    android:background="@drawable/bg_circle_white"
                    android:padding="4dp"/>
            </FrameLayout>
            
            <EditText
                android:id="@+id/et_display_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="展示名"
                android:textSize="16sp"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_hint"
                android:background="@android:color/transparent"
                android:padding="12dp"/>
        </LinearLayout>

        <!-- 所在城市 -->
        <EditText
            android:id="@+id/et_city"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:hint="所在城市"
            android:textSize="16sp"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_hint"
            android:background="@drawable/input_field_bg"
            android:paddingHorizontal="16dp"
            android:layout_marginBottom="12dp"/>

        <!-- 一句话简介 -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp">
            
            <EditText
                android:id="@+id/et_brief_intro"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:hint="一句话简介"
                android:textSize="16sp"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_hint"
                android:maxLength="200"
                android:background="@drawable/input_field_bg"
                android:paddingHorizontal="16dp"
                android:paddingBottom="24dp"/>
            
            <TextView
                android:id="@+id/tv_brief_counter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0/200"
                android:textColor="@color/text_hint"
                android:textSize="12sp"
                android:layout_gravity="bottom|end"
                android:layout_marginEnd="16dp"
                android:layout_marginBottom="8dp"/>
        </FrameLayout>

        <!-- 学历背景 -->
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
            app:boxStrokeColor="@color/settings_divider"
            app:hintTextColor="@color/text_hint">
            
            <AutoCompleteTextView
                android:id="@+id/et_education"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:hint="学历背景"
                android:inputType="none"
                android:textSize="16sp"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_hint"
                android:paddingHorizontal="16dp"/>
        </com.google.android.material.textfield.TextInputLayout>

        <!-- 工作年限 -->
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
            app:boxStrokeColor="@color/settings_divider"
            app:hintTextColor="@color/text_hint">
            
            <AutoCompleteTextView
                android:id="@+id/et_years"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:hint="工作年限"
                android:inputType="none"
                android:textSize="16sp"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_hint"
                android:paddingHorizontal="16dp"/>
        </com.google.android.material.textfield.TextInputLayout>

        <!-- 详细个人介绍 -->
        <EditText
            android:id="@+id/et_rich_bio"
            android:layout_width="match_parent"
            android:layout_height="180dp"
            android:gravity="top|start"
            android:hint="详细个人介绍"
            android:textSize="16sp"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_hint"
            android:background="@drawable/input_field_bg"
            android:padding="16dp"
            android:layout_marginBottom="16dp"/>

        <!-- 擅长领域标签 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="12dp"
            android:paddingVertical="8dp">
            
            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_tag"
                android:tint="@color/text_primary"
                android:layout_marginEnd="8dp"/>
            
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="擅长领域"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:textStyle="bold"/>
            
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="最多选择5个"
                android:textColor="@color/text_hint"
                android:textSize="12sp"/>
        </LinearLayout>

        <!-- 擅长领域标签容器 -->
        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chip_group_expertise"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            app:chipSpacing="8dp"
            app:singleLine="false"/>

        <!-- 添加标签按钮 -->
        <Button
            android:id="@+id/btn_add_expertise_tag"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="+ 添加擅长领域"
            android:textColor="@color/primary"
            android:textSize="14sp"
            android:background="@drawable/bg_button_outline"
            android:layout_marginBottom="24dp"
            style="?android:attr/borderlessButtonStyle"/>

        <!-- 提交变更按钮 -->
        <Button
            android:id="@+id/btn_submit_changes"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="提交变更"
            android:textColor="@android:color/white"
            android:textSize="16sp"
            android:background="@drawable/bg_button_primary"
            android:layout_marginTop="8dp"/>

    </LinearLayout>
</ScrollView>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tv_start_date"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="2024-01-01"
            android:textSize="14sp"
            android:padding="8dp"
            android:background="#EEEEEE"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="至"
            android:padding="8dp"/>

        <TextView
            android:id="@+id/tv_end_date"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="2024-12-31"
            android:textSize="14sp"
            android:padding="8dp"
            android:background="#EEEEEE"/>
    </LinearLayout>

    <Button
        android:id="@+id/btn_filter"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="筛选"
        android:layout_marginTop="8dp"
        android:visibility="gone"/>

    

    <RadioGroup
        android:id="@+id/rg_sort"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="8dp">
        <RadioButton
            android:id="@+id/rb_sort_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="按日期"
            android:checked="true"/>
        <RadioButton
            android:id="@+id/rb_sort_score"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="按分数"/>
    </RadioGroup>

    <!-- 图表切换按钮 -->
    <Button
        android:id="@+id/btn_toggle_chart"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="显示图表"
        android:layout_marginTop="8dp"/>

    <!-- 分数趋势折线图 -->
    <com.github.mikephil.charting.charts.LineChart
        android:id="@+id/line_score_trend"
        android:layout_width="match_parent"
        android:layout_height="200dp"
        android:layout_marginTop="8dp"
        android:visibility="gone"/>

    <!-- 风险分布切换按钮 -->
    <Button
        android:id="@+id/btn_toggle_risk"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="显示风险分布"
        android:layout_marginTop="8dp"/>

    <!-- 风险分布饼图 -->
    <com.github.mikephil.charting.charts.PieChart
        android:id="@+id/pie_risk_dist"
        android:layout_width="match_parent"
        android:layout_height="200dp"
        android:layout_marginTop="8dp"
        android:visibility="gone"/>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_test_reports"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingTop="8dp"/>

</LinearLayout>

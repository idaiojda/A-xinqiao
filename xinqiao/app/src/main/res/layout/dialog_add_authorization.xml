<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/counselor_name_label"
            android:textColor="#333333" />

        <EditText
            android:id="@+id/et_counselor_name"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:background="#F5F5F5"
            android:padding="8dp"
            android:hint="@string/counselor_name_hint" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/authorization_scope_label"
            android:textColor="#333333" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="6dp">
            <CheckBox
                android:id="@+id/cb_consult"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/scope_consult_records" />
            <View
                android:layout_width="16dp"
                android:layout_height="0dp" />
            <CheckBox
                android:id="@+id/cb_test"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/scope_test_reports" />
            <View
                android:layout_width="16dp"
                android:layout_height="0dp" />
            <CheckBox
                android:id="@+id/cb_diary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/scope_emotion_diary" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/effective_duration_label"
            android:textColor="#333333" />

        <RadioGroup
            android:id="@+id/rg_duration"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="6dp">
            <RadioButton
                android:id="@+id/rb_1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/duration_1_day" />
            <View
                android:layout_width="16dp"
                android:layout_height="0dp" />
            <RadioButton
                android:id="@+id/rb_3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/duration_3_days" />
            <View
                android:layout_width="16dp"
                android:layout_height="0dp" />
            <RadioButton
                android:id="@+id/rb_7"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/duration_7_days" />
        </RadioGroup>

    </LinearLayout>
</ScrollView>

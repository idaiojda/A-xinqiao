<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F9FB">

    <!-- 顶部渐变搜索栏 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_gradient_header">
        
        <!-- 搜索栏容器 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:layout_marginTop="8dp">
            
            <ImageButton
                android:id="@+id/iv_back"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="返回"
                android:src="@drawable/ic_back"
                android:tint="@android:color/white"
                android:visibility="gone"/>
                
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_searchbar_pill_selector"
                android:paddingStart="12dp"
                android:paddingEnd="12dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_search_blue"
                    android:tint="#7F8C8D"/>

                <EditText
                    android:id="@+id/et_search"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="match_parent"
                    android:hint="搜索心理测评..."
                    android:textSize="15sp"
                    android:textColor="#2C3E50"
                    android:textColorHint="#99B8FF"
                    android:background="@android:color/transparent"
                    android:paddingStart="8dp"
                    android:imeOptions="actionSearch"
                    android:inputType="text"
                    android:maxLines="1"/>

            </LinearLayout>
            
            <ImageView
                android:id="@+id/iv_clear"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_delete"
                android:tint="#999999"
                android:visibility="gone"
                android:layout_marginEnd="8dp"/>
                
            <TextView
                android:id="@+id/tv_cancel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="取消"
                android:textColor="@android:color/white"
                android:textSize="15sp"
                android:textStyle="bold"
                android:paddingStart="12dp"
                android:paddingEnd="4dp"/>
                
        </LinearLayout>
        
        <!-- 装饰性元素 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">
            
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="发现更多心理测评"
                android:textColor="@android:color/white"
                android:textSize="14sp"
                android:alpha="0.8"/>
                
            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"
                android:background="@android:color/white"
                android:alpha="0.3"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp"/>
                
            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_search_blue"
                android:tint="@android:color/white"
                android:alpha="0.6"/>
                
        </LinearLayout>
        
    </LinearLayout>

    <!-- 热搜区块 -->
    <LinearLayout
        android:id="@+id/ll_hot"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp"
        android:background="@android:color/white"
        android:layout_margin="16dp"
        android:elevation="4dp"
        android:outlineProvider="background">
        
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp">
            
            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_fire"
                android:tint="#FF6B35"/>
                
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="热门搜索"
                android:textColor="#2C3E50"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginStart="8dp"/>
                
            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"
                android:background="#E8E8E8"
                android:layout_marginStart="12dp"/>
                
        </LinearLayout>
        
        <com.google.android.flexbox.FlexboxLayout
            android:id="@+id/flow_hot"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:flexWrap="wrap"
            app:justifyContent="flex_start"/>
            
    </LinearLayout>

    <!-- 历史搜索区块 -->
    <LinearLayout
        android:id="@+id/ll_history"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp"
        android:background="@android:color/white"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="16dp"
        android:elevation="4dp"
        android:outlineProvider="background">
        
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp">
            
            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_history"
                android:tint="#8B5CF6"/>
                
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="搜索历史"
                android:textColor="#2C3E50"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginStart="8dp"/>
                
            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"
                android:background="#E8E8E8"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp"/>
                
            <TextView
                android:id="@+id/tv_clear_history"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="清空"
                android:textColor="#8B5CF6"
                android:textSize="14sp"
                android:textStyle="bold"
                android:padding="8dp"/>
                
        </LinearLayout>
        
        <com.google.android.flexbox.FlexboxLayout
            android:id="@+id/flow_history"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:flexWrap="wrap"
            app:justifyContent="flex_start"/>
            
    </LinearLayout>

    <!-- 热度排行区块 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="16dp">
        
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="12dp">
            
            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_trophy"
                android:tint="#FFD700"/>
                
            <TextView
                android:id="@+id/tv_hot_rank_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="热度排行榜"
                android:textColor="#2C3E50"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginStart="8dp"/>
                
            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"
                android:background="#E8E8E8"
                android:layout_marginStart="12dp"/>
                
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="TOP 10"
                android:textColor="#999999"
                android:textSize="12sp"
                android:padding="4dp"/>
                
        </LinearLayout>
        
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="16dp"
            app:cardElevation="4dp"
            app:cardBackgroundColor="@android:color/white">
            
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_hot_rank"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="12dp"
                android:overScrollMode="never"
                android:scrollbars="none"/>
                
        </androidx.cardview.widget.CardView>
        
    </LinearLayout>

    <!-- 搜索结果 -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_search_result"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="16dp"
        android:clipToPadding="false"
        android:overScrollMode="never"
        android:visibility="gone"/>

    <!-- 无结果提示 -->
    <LinearLayout
        android:id="@+id/tv_empty"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:visibility="gone"
        android:padding="32dp">
        
        <ImageView
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:src="@drawable/ic_search_blue"
            android:tint="#E8E8E8"
            android:layout_marginBottom="16dp"/>
            
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="未找到相关测评"
            android:textColor="#999999"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp"/>
            
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="试试其他关键词吧"
            android:textColor="#CCCCCC"
            android:textSize="14sp"/>
            
    </LinearLayout>
    
</LinearLayout>
